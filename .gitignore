/docs/design/
/docs/validation/*.png
/docs/validation/*.jpg
/docs/validation/*.jpeg
/docs/validation/*.webp
/docs/validation/*.gif
/artifacts/

# Temporary design explorations belong outside the maintained application
/design-previews/
/scratch/
/tmp/

# Local embedded-store scratch file
/:memory:.ses

