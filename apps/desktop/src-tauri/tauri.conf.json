{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vesper",
  "version": "0.1.1",
  "identifier": "com.vesper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Vesper",
        "width": 1180,
        "height": 840,
        "minWidth": 360,
        "minHeight": 480
      },
      {
        "label": "quick-capture",
        "title": "Vesper quick capture",
        "url": "index.html",
        "width": 396,
        "height": 192,
        "minWidth": 120,
        "minHeight": 64,
        "center": true,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "backgroundThrottling": "disabled",
        "shadow": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://rahulsharmavishwakarma.github.io/vesper/latest.json",
        "https://github.com/rahulsharmavishwakarma/vesper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQTE3MUVDOTA5QzAxMDYKUldRR0FaeVE3SEdoL2E1Y2QwN1FhS3lVSXBXQUJtclVUeCt4eERTaElRQzlzWFFHY3JiVUxKbVEK"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
