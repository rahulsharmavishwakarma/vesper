+// Scores for the application-local Whisper adapter. No sampling changes.
+#ifndef SHERPA_ONNX_CSRC_TRANSCRIBE_WHISPER_SCORE_H_
+#define SHERPA_ONNX_CSRC_TRANSCRIBE_WHISPER_SCORE_H_
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+#include "sherpa-onnx/csrc/transcribe-decode-report.h"
+namespace sherpa_onnx {
+inline double TranscribeWhisperLogProbability(const float *row, int32_t size,
+                                             int32_t token) {
+  if (token < 0 || token >= size || !TranscribeValidGreedyLogits(row, size) ||
+      !std::isfinite(row[token])) {
+    throw std::runtime_error("Invalid Whisper logits or token");
+  }
+  const double maximum = *std::max_element(row, row + size);
+  double sum = 0;
+  for (int32_t i = 0; i < size; ++i) sum += std::exp(row[i] - maximum);
+  return row[token] - maximum - std::log(sum);
+}
+inline int32_t TranscribeWhisperBudget(int32_t context, int32_t prompt) {
+  // OpenAI's default sample_len is n_text_ctx/2, independent of language and
+  // duration. Leave room for the next forward pass within the fixed KV cache.
+  if (context <= 0 || prompt < 0 || prompt >= context) return 0;
+  return std::min(context / 2, context - prompt - 1);
+}
+inline const char *TranscribeWhisperStop(bool eos, bool context_limit) {
+  return eos ? "eos" : (context_limit ? "context_limit" : "model_token_limit");
+}
+}  // namespace sherpa_onnx
+#endif
