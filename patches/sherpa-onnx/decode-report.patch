+// Application-local completion contract for the pinned sherpa-onnx build.
+// Cohere/Qwen: reporting only. Whisper also removes the duration-derived cap;
+// see the architecture-specific patch below and docs/research-whisper.md.
+#ifndef SHERPA_ONNX_CSRC_TRANSCRIBE_DECODE_REPORT_H_
+#define SHERPA_ONNX_CSRC_TRANSCRIBE_DECODE_REPORT_H_
+#include <string>
+#include <cmath>
+#include <cstdint>
+namespace sherpa_onnx {
+inline constexpr const char *kTranscribeDecodeReport = "transcribe.decode_report.v1";
+inline constexpr const char *kTranscribeInputTruncated = "transcribe.input_truncated.v1";
+// Templates allow exercising the exact contract without loading a model.
+template <typename Stream>
+void TranscribeReport(Stream *s, const char *reason) {
+  const bool truncated = s->GetOption(kTranscribeInputTruncated) == "true";
+  s->SetOption(kTranscribeDecodeReport,
+      std::string("{\"schemaVersion\":1,\"stopReason\":\"") + reason +
+      "\",\"inputContextTruncated\":" + (truncated ? "true}" : "false}"));
+}
+template <typename Stream>
+void TranscribeBegin(Stream *s) {
+  s->SetOption(kTranscribeInputTruncated, "false");
+  // All unlabelled early returns fail closed; no previous report survives.
+  TranscribeReport(s, "error");
+}
+template <typename Stream>
+void TranscribeInputTruncated(Stream *s) {
+  s->SetOption(kTranscribeInputTruncated, "true");
+  TranscribeReport(s, "context_limit");
+}
+// Shared by reporting and native tests; EOS at the final cap is still EOS.
+inline const char *TranscribeCohereStop(bool eos, bool model_limit) {
+  return eos ? "eos" : (model_limit ? "model_token_limit" : "duration_token_limit");
+}
+template <typename Read>
+bool TranscribeHasFiniteLogit(int64_t size, int64_t avoid, Read read) {
+  for (int64_t i = 0; i < size; ++i) {
+    if (i != avoid && std::isfinite(read(i))) return true;
+  }
+  return false;
+}
+// Eigen argmax does not share Qwen's nonfinite-value filtering. Preserve
+// negative-infinity masks, but reject NaN/positive infinity before argmax.
+inline bool TranscribeValidGreedyLogits(const float *values, int64_t size) {
+  bool finite = false;
+  for (int64_t i = 0; i < size; ++i) {
+    if (std::isnan(values[i]) || values[i] == INFINITY) return false;
+    finite = finite || std::isfinite(values[i]);
+  }
+  return finite;
+}
+}  // namespace sherpa_onnx
+#endif
