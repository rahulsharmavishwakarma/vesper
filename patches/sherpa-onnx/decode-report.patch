+// Validate the sampled row before the upstream sampler can silently fall back
+// to token zero. Finite masked rows are valid; an all-nonfinite row is not.
+static bool TranscribeValidLogits(const Ort::Value &logits, int32_t time,
+                                 int64_t avoid_id = -1) {
+  auto info = logits.GetTensorTypeAndShapeInfo();
+  auto shape = info.GetShape();
+  if (shape.size() != 3 || shape[0] != 1 || shape[1] <= time || time < 0 ||
+      shape[2] <= 0) return false;
+  const auto type = info.GetElementType();
+  if (type != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT &&
+      type != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT16 &&
+      type != ONNX_TENSOR_ELEMENT_DATA_TYPE_UINT16) return false;
+  const auto offset = static_cast<size_t>(time) * shape[2];
+  return TranscribeHasFiniteLogit(shape[2], avoid_id, [&](int64_t i) {
+    return type == ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT
+        ? logits.GetTensorData<float>()[offset + i]
+        : HalfBitsToFloat(logits.GetTensorData<uint16_t>()[offset + i]);
+  });
+}
