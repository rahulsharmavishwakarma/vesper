+/// Pinned Vesper patch: one decode step plus the serial loop's reductions
+/// (`tdtStep`), as a single compiled call. Inputs: frame, time, newSymbols,
+/// lastToken [1, 1], hidden, cell, frame count. Outputs: the step record
+/// [active, time, newSymbols, token, decisionIndex, jump] and the next loop
+/// state. Inactive steps (time >= frame count) leave the state unchanged.
+private func makeCompiledBlockedTDTStep(
+    step: @escaping @Sendable ([MLXArray]) -> [MLXArray],
+    blankTokenId: Int,
+    durations: [Int],
+    maxSymbols: Int?
+) -> @Sendable ([MLXArray]) -> [MLXArray] {
+    let blank = MLXArray(Int32(blankTokenId))
+    let durationTable = MLXArray(durations.map { Int32($0) })
+    let symbolLimit = MLXArray(Int32(clamping: maxSymbols ?? Int(Int32.max)))
+    let zero = MLXArray(Int32(0))
+    let one = MLXArray(Int32(1))
+    return compile { arrays in
+        let (frame, time, newSymbols, lastToken, hidden, cell, limit) =
+            (arrays[0], arrays[1], arrays[2], arrays[3], arrays[4], arrays[5], arrays[6])
+        let active = time .< limit
+        let outputs = step([frame, lastToken, hidden, cell])
+        let token = outputs[0][0]
+        let decisionIndex = outputs[0][1]
+        let jump = durationTable.take(decisionIndex)
+        let counted = newSymbols + one
+        let moved = jump .!= zero
+        let capped = .!moved .&& (counted .>= symbolLimit)
+        let nextTime = MLX.where(moved, time + jump, MLX.where(capped, time + one, time))
+        let nextSymbols = MLX.where(moved .|| capped, zero, counted)
+        let commit = active .&& (token .!= blank)
+        let record = MLX.stacked([active.asType(.int32), time, newSymbols, token, decisionIndex, jump])
+        return [
+            record,
+            MLX.where(active, nextTime, time),
+            MLX.where(active, nextSymbols, newSymbols),
+            MLX.where(commit, token, lastToken.reshaped([])).reshaped([1, 1]),
+            MLX.where(commit, outputs[1], hidden),
+            MLX.where(commit, outputs[2], cell),
+        ]
     }
