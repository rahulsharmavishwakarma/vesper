+    /// The same compiled step and reductions as `decodeTDTSerial`, but the
+    /// frame index, symbol count, last token and decoder state stay on the
+    /// device. Each host synchronization covers `tdtBlockSteps` steps instead
+    /// of one; steps after the end are masked and leave the state unchanged.
+    private func decodeTDTBlocked(batchFeatures: MLXArray, lengths: MLXArray) -> [ParakeetAlignedResult] {
+        var results: [ParakeetAlignedResult] = []
+        let blankToken = blankTokenId
+        let zero = MLXArray(Int32(0))
+
+        for b in 0..<batchFeatures.shape[0] {
+            let featureSeq = batchFeatures[b..<(b + 1)]
+            let maxLength = Int(lengths[b].item(Int32.self))
+            let lastFrame = MLXArray(Int32(maxLength - 1))
+            let limit = MLXArray(Int32(maxLength))
+            let initial = makeInitialDecoderState(batchSize: 1, dtype: computeDType)
+            var hidden = initial.hidden!
+            var cell = initial.cell!
+            var time = zero
+            var newSymbols = zero
+            var currentToken = MLXArray(Int32(blankToken)).reshaped([1, 1])
+            var hypothesis: [ParakeetAlignedToken] = []
+            var hostTime = 0
 
+            while hostTime < maxLength {
+                if Task.isCancelled { break }
+                var records: [MLXArray] = []
+                for _ in 0..<tdtBlockSteps {
+                    let frame = featureSeq.take(minimum(time, lastFrame).reshaped([1]), axis: 1)
+                    let next = compiledBlockedTDTStep([frame, time, newSymbols, currentToken, hidden, cell, limit])
+                    records.append(next[0])
+                    time = next[1]
+                    newSymbols = next[2]
+                    currentToken = next[3]
+                    hidden = next[4]
+                    cell = next[5]
+                }
+                let block = MLX.stacked(records)
+                MLX.eval(block, time, newSymbols, currentToken, hidden, cell)
+                let values = block.asArray(Int32.self)
+                for step in 0..<tdtBlockSteps {
+                    let row = Array(values[(step * 6)..<(step * 6 + 6)]).map(Int.init)
+                    guard row[0] == 1 else { break }
+                    let token = row[3]
+                    tdtTraceEmitter?(
+                        TDTTraceStep(
+                            row: b, time: row[1], newSymbols: row[2], token: token,
+                            decisionIndex: row[4], committedState: token != blankToken))
+                    if token != blankToken, !ParakeetTokenizer.isSpecialToken(token, vocabulary: vocabulary) {
+                        hypothesis.append(
+                            ParakeetAlignedToken(
+                                id: token,
+                                text: ParakeetTokenizer.decode(tokens: [token], vocabulary: vocabulary),
+                                start: frameTimeSeconds(frameIndex: row[1]),
+                                duration: frameTimeSeconds(frameIndex: row[5])))
+                    }
+                }
+                hostTime = Int(time.item(Int32.self))
+            }
+            results.append(
+                ParakeetAlignment.sentencesToResult(ParakeetAlignment.tokensToSentences(hypothesis)))
+        }
+        return results
+    }
