+    /// Pinned Vesper patch: decode one window from external encoder output
+    /// [1, frames, dModel] with fresh decoder state, as `generate` does after
+    /// its own encoder.
+    func vesperDecode(encoded: MLXArray, frames: Int) -> STTOutput {
+        let result = decodeEncoded(
+            batchFeatures: encoded.asType(computeDType), lengths: MLXArray([Int32(frames)])
+        )[0]
+        return STTOutput(
+            text: result.text,
+            segments: result.segments,
+            vesperCompletionReason: Task.isCancelled ? "cancelled" : "audio_consumed"
+        )
     }
 
